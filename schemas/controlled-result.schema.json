{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echosight.local/schemas/controlled-result-1.0.json",
  "title": "EchoSight controlled recording result v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "receiver_evidence",
    "conditional_spatial_changes",
    "epoch_results",
    "physical_validation",
    "physical_scene_change_established",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "no_repeatable_change",
        "repeatable_acoustic_change_unlocalized",
        "conditional_spatial_change",
        "inconclusive",
        "cancelled"
      ]
    },
    "protocol_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "physical_validation": {
      "const": false
    },
    "physical_scene_change_established": {
      "const": false
    },
    "diagnostics": {
      "type": "array"
    },
    "receiver_evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "capture_id",
          "repeat_consistent",
          "repeatable_change",
          "shifted_positive_echoes",
          "gate_semantics"
        ]
      }
    },
    "conditional_spatial_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "previous_surface_id",
          "current_surface_id",
          "offset_change_m",
          "offset_reference_point_m",
          "positive_echo_capture_ids",
          "claim"
        ]
      }
    },
    "epoch_results": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "epoch",
          "result"
        ],
        "properties": {
          "epoch": {
            "type": "string"
          },
          "result": {
            "$ref": "result-1.0.json"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "receiver_evidence": {
            "maxItems": 0
          },
          "conditional_spatial_changes": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
